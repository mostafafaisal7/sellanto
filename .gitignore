target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the Python is
#   managed by the user. However, for a project, you might want to keep it.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if you want to keep your dependencies next to your project:
#Pipfile.lock

# poetry
#   Similar to Pipenv, it is generally recommended to include poetry.lock in version control.
#   poetry.lock
#   pyproject.toml

# pdm
#   Similar to Pipenv, it is generally recommended to include pdm.lock in version control.
#   pdm.lock
#   pyproject.toml

# runtime
#   If you are using a shared runtime environment (e.g. at a company), you
#   might want to ignore it here.
# .runtime/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

