# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Choose your database engine:
#   - 'sqlite' → Development only (default, no setup required)
#   - 'postgresql' → Production (recommended)
#   - 'mysql' → Production (alternative)
#
# ⚠️ IMPORTANT: SQLite is NOT safe for production with concurrent users!
# ═══════════════════════════════════════════════════════════════════════════

# OPTION 1: SQLite (Development - Default)
# No additional configuration needed, just leave DB_ENGINE empty or set to 'sqlite'
# DB_ENGINE=sqlite

# OPTION 2: PostgreSQL (Production - Recommended)
# Requires: pip install psycopg2-binary
# DB_ENGINE=postgresql
# DB_NAME=sellanto_db
# DB_USER=sellanto_user
# DB_PASSWORD=your-secure-password-here
# DB_HOST=localhost
# DB_PORT=5432

# OPTION 3: MySQL (Production - Alternative)
# Requires: pip install mysqlclient
# DB_ENGINE=mysql
# DB_NAME=sellanto_db
# DB_USER=sellanto_user
# DB_PASSWORD=your-secure-password-here
# DB_HOST=localhost
# DB_PORT=3306

# For development, you can leave the database settings commented out
# The system will default to SQLite automatically

# Timezone
TIME_ZONE=

# Anthropic Claude API (global admin key - shared by all users for text AI)
ANTHROPIC_API_KEY=